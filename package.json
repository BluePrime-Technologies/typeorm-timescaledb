{
  "name": "typeorm-timescaledb-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for typeorm-timescaledb \u2014 a multi-DataSource-safe TimescaleDB integration for TypeORM.",
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:package-smoke": "node scripts/package-smoke-test.mjs",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check:version-claims": "node scripts/check-version-claims.mjs",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "turbo": "^2.10.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.0.16",
    "vitest": "^5.0.0"
  }
}
