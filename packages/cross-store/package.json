{
  "name": "@blueprime/cross-store",
  "version": "0.0.0",
  "description": "Validated cross-store (@Resolve) references between TimescaleDB and another database.",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test:unit": "vitest run --passWithNoTests",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@blueprime/timescaledb-core": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
