{
  "name": "@blueprime/cross-store",
  "version": "0.0.0",
  "description": "Validated cross-store (@Resolve) references between TimescaleDB and another database.",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./typeorm": {
      "import": {
        "types": "./dist/typeorm.d.ts",
        "default": "./dist/typeorm.js"
      }
    },
    "./prisma": {
      "import": {
        "types": "./dist/prisma.d.ts",
        "default": "./dist/prisma.js"
      }
    }
  },
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "typeorm": [
        "./dist/typeorm.d.ts"
      ],
      "prisma": [
        "./dist/prisma.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test:unit": "vitest run --passWithNoTests --exclude '**/*.integration.test.ts'",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@blueprime/timescaledb-core": "workspace:*"
  },
  "peerDependencies": {
    "@prisma/client": "^5.0.0 || ^6.0.0",
    "typeorm": "^0.3.20 || ^1.0.0"
  },
  "peerDependenciesMeta": {
    "@prisma/client": {
      "optional": true
    },
    "typeorm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@prisma/client": "^6.0.0",
    "pg": "^8.21.0",
    "prisma": "^6.0.0",
    "testcontainers": "^12.0.1",
    "typeorm": "^1.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
