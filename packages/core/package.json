{
  "name": "@blueprime-technologies/timescaledb-core",
  "version": "0.1.0",
  "description": "ORM-agnostic core for TimescaleDB: SQL/DDL generation, metadata model, identifier safety.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b && tsc -p tsconfig.cjs.json && node ../../scripts/write-cjs-pkgjson.mjs",
    "typecheck": "tsc -b",
    "test:unit": "vitest run --passWithNoTests",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "fast-check": "^3.23.2"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/index.js",
  "engines": {
    "node": ">=20.19 || >=22.12"
  }
}
