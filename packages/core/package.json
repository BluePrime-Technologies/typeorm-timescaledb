{
  "name": "@blueprime/timescaledb-core",
  "version": "0.7.1",
  "description": "Pre-1.0 ORM-agnostic core for TimescaleDB SQL/DDL generation, metadata modeling, and identifier safety.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b && tsc -p tsconfig.cjs.json && node ../../scripts/write-cjs-pkgjson.mjs",
    "typecheck": "tsc -b",
    "test:unit": "vitest run --passWithNoTests",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "fast-check": "^4.9.0"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BluePrime-Technologies/typeorm-timescaledb.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/BluePrime-Technologies/typeorm-timescaledb#readme",
  "bugs": {
    "url": "https://github.com/BluePrime-Technologies/typeorm-timescaledb/issues"
  }
}
