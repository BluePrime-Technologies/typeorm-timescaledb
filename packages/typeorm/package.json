{
  "name": "typeorm-timescaledb",
  "version": "0.7.1",
  "description": "Pre-1.0 TypeORM integration for TimescaleDB: typed hypertables, columnstore, retention, reviewable migrations, and a typed hyperfunction query layer with stable toolkit aggregates.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./nestjs": {
      "import": {
        "types": "./dist/nestjs/index.d.ts",
        "default": "./dist/nestjs/index.js"
      },
      "require": {
        "types": "./dist/cjs/nestjs/index.d.ts",
        "default": "./dist/cjs/nestjs/index.js"
      }
    }
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "typeorm-timescaledb": "./dist/cli/main.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b && tsc -p tsconfig.cjs.json && node ../../scripts/write-cjs-pkgjson.mjs",
    "typecheck": "tsc -b",
    "test:unit": "vitest run --passWithNoTests --exclude '**/*.integration.test.ts'",
    "test": "vitest run --passWithNoTests",
    "prepack": "cp ../../README.md README.md"
  },
  "dependencies": {
    "@blueprime/timescaledb-core": "workspace:*"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0",
    "reflect-metadata": "^0.2.0",
    "typeorm": "^0.3.20 || ^1.0.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/core": {
      "optional": true
    },
    "reflect-metadata": {
      "optional": false
    }
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "keywords": [
    "typeorm",
    "timescaledb",
    "timescale",
    "hypertable",
    "time-series",
    "postgres",
    "postgresql",
    "orm",
    "nestjs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BluePrime-Technologies/typeorm-timescaledb.git",
    "directory": "packages/typeorm"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@nestjs/common": "^11.2.1",
    "@nestjs/core": "^11.2.1",
    "@nestjs/testing": "^11.2.1",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "testcontainers": "12.0.1",
    "typeorm": "^1.1.0"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/index.js",
  "typesVersions": {
    "*": {
      "nestjs": [
        "./dist/nestjs/index.d.ts"
      ]
    }
  },
  "homepage": "https://github.com/BluePrime-Technologies/typeorm-timescaledb#readme",
  "bugs": {
    "url": "https://github.com/BluePrime-Technologies/typeorm-timescaledb/issues"
  }
}
