{
  "name": "typeorm-timescaledb",
  "version": "0.0.0",
  "description": "A complete, multi-DataSource-safe TimescaleDB integration for TypeORM.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./nestjs": {
      "import": {
        "types": "./dist/nestjs/index.d.ts",
        "default": "./dist/nestjs/index.js"
      }
    }
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "typeorm-timescaledb": "./dist/cli/main.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test:unit": "vitest run --passWithNoTests --exclude '**/*.integration.test.ts'",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@blueprime-technologies/timescaledb-core": "workspace:*"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0",
    "reflect-metadata": "^0.2.0",
    "typeorm": "^0.3.20 || ^1.0.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/core": {
      "optional": true
    },
    "reflect-metadata": {
      "optional": false
    }
  },
  "engines": {
    "node": ">=20.19 || >=22.12"
  },
  "keywords": [
    "typeorm",
    "timescaledb",
    "timescale",
    "hypertable",
    "time-series",
    "postgres",
    "postgresql",
    "orm",
    "nestjs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BluePrime-Technologies/typeorm-timescaledb.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@nestjs/common": "^11.1.26",
    "@nestjs/core": "^11.1.26",
    "@nestjs/testing": "^11.1.26",
    "pg": "^8.21.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "testcontainers": "^12.0.1",
    "typeorm": "^1.0.0"
  }
}
